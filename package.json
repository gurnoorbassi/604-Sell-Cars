{
  "name": "dealership-inventory-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "import:seed": "node server/import-seed.js",
    "migrate:media:vps": "node server/migrate-media-to-vps.js",
    "check": "node --check server/index.js && node --check server/routes/public.js && node --check server/routes/admin.js",
    "test": "vitest run",
    "backup:data": "node --env-file-if-exists=.env scripts/backup-data.mjs",
    "preview": "vite preview",
    "import:trello": "node --env-file-if-exists=.env scripts/import-trello.mjs",
    "import:trello-export": "node scripts/import-trello-export.mjs",
    "classify:inventory": "node scripts/classify-inventory.mjs --write",
    "migrate:media": "node --env-file-if-exists=.env scripts/migrate-media-to-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "10.5.4",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jszip": "3.10.1",
    "lucide-react": "1.25.0",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "postcss": "8.5.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.19",
    "tus-js-client": "4.3.1",
    "twilio": "^6.0.2",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@netlify/functions": "5.3.0",
    "concurrently": "^9.2.4",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "vitest": "4.1.10"
  }
}
